{
  "name": "mzigo-ledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm:build": "bash scripts/build-wasm.sh",
    "predev": "npm run wasm:build",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run wasm:build",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
